# Seller server port (avoid conflict — facilitator uses 8402)
PORT=8403

# URL of the running TalosFacilitator (Aureus) — typically localhost during dev
FACILITATOR_URL=http://localhost:8402

# Address that receives USDC for paid requests
SELLER_ADDRESS=0x0000000000000000000000000000000000000000

# Price per request in USDC (decimal string, max 6 places)
PRICE_USDC=0.01
